#!/bin/sh
if [ -x /usr/local/bin/python3 ]; then
    PY=/usr/local/bin/python3
else
    PY=$(ls -1 /usr/local/bin/python3.[0-9][0-9] 2>/dev/null | tail -n 1)
fi
if [ -z "${PY}" ] || [ ! -x "${PY}" ]; then
    echo "Sophos Frontpanel: no Python 3 interpreter found under /usr/local/bin" >&2
    exit 69
fi
exec "${PY}" /usr/local/opnsense/scripts/sophos_frontpanel/frontpaneld.py "$@"
